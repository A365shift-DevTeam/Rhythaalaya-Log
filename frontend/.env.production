# Loaded automatically by Vite when running in production mode (npm run build / vite build).
# Backend API base URL — must match the domain the backend is actually deployed to, and that
# domain must in turn be listed in the backend's Cors:AllowedOrigins (see
# backend/RhythaalayaLog.API/appsettings.json).
VITE_API_URL=https://batchlyapi.ambot365.com/api
